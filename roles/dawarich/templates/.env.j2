{{ ansible_managed | comment }}

# See https://dawarich.app/docs/self-hosting/environment-variables/

RAILS_ENV=production
SELF_HOSTED=true
STORE_GEODATA={{ dawarich__store_geodata | string | lower }}

DAWARICH_APP_PORT={{ dawarich__web_port }}

POSTGRES_USER={{ dawarich__postgres_user }}
POSTGRES_PASSWORD={{ dawarich__postgres_password }}
POSTGRES_DB={{ dawarich__postgres_db }}

DATABASE_HOST=dawarich_db
DATABASE_PORT=5432
DATABASE_USERNAME={{ dawarich__postgres_user }}
DATABASE_PASSWORD={{ dawarich__postgres_password }}
DATABASE_NAME={{ dawarich__postgres_db }}

REDIS_URL=redis://dawarich_redis:6379

# Keep http behind nginx; TLS is terminated by the reverse proxy.
# See https://dawarich.app/docs/self-hosting/configuration/reverse-proxy/
APPLICATION_HOSTS={{ dawarich__domain }},127.0.0.1
APPLICATION_PROTOCOL=http
DOMAIN={{ dawarich__domain }}
TIME_ZONE={{ dawarich__time_zone }}

SECRET_KEY_BASE={{ dawarich__secret_key_base }}
RAILS_LOG_TO_STDOUT=true
PROMETHEUS_EXPORTER_ENABLED=false

BACKGROUND_PROCESSING_CONCURRENCY={{ dawarich__background_processing_concurrency }}

LOG_MAX_SIZE={{ dawarich__log_max_size }}
LOG_MAX_FILE={{ dawarich__log_max_file }}

APP_CPU_LIMIT={{ dawarich__app_cpu_limit }}
APP_MEMORY_LIMIT={{ dawarich__app_memory_limit }}

{% if dawarich__photon_api_host is defined and dawarich__photon_api_host | length > 0 -%}
# Reverse geocoding: https://dawarich.app/docs/self-hosting/configuration/reverse-geocoding/
PHOTON_API_HOST={{ dawarich__photon_api_host }}
PHOTON_API_USE_HTTPS={{ dawarich__photon_api_use_https | string | lower }}
{% if dawarich__photon_api_key is defined and dawarich__photon_api_key | length > 0 -%}
PHOTON_API_KEY={{ dawarich__photon_api_key }}
{% endif -%}
{% endif -%}
