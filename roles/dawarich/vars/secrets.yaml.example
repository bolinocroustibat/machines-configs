# Dawarich secrets configuration
# Copy this file to secrets.yaml and update with your actual values

# Public domain (DNS A record must point to the target host)
dawarich__domain: "dawarich.example.com"

# Host port bound to localhost (nginx proxies to this port)
dawarich__web_port: 3002

# PostgreSQL credentials
dawarich__postgres_user: "postgres"
dawarich__postgres_password: "CHANGE_ME"
dawarich__postgres_db: "dawarich_production"

# Rails secret (generate with: openssl rand -hex 64)
dawarich__secret_key_base: "CHANGE_ME"

# Reverse geocoding (Photon-compatible)
# See https://dawarich.app/docs/self-hosting/configuration/reverse-geocoding/
# Self-hosted Photon: set photon_api_host only (no API key).
# chibigeo / other providers: also set photon_api_key.
# dawarich__photon_api_host: "home.example.com/photon"
# dawarich__photon_api_use_https: true
# dawarich__photon_api_key: "CHANGE_ME"
