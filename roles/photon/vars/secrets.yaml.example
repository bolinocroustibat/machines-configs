# Parent domain for subpath mode, or dedicated subdomain for subdomain mode.
# Override per host in host_vars to move Photon between pi-bolino, web-bolino, or data-bolino.
photon__domain: "home.example.com"

# Optional: only used when photon__nginx_mode is subpath (default in defaults/main.yaml)
# photon__path: "/photon/"

# Optional: override defaults from roles/photon/defaults/main.yaml
# photon__region: "planet"   # default; use "europe", "fr", etc. for a smaller index
# photon__bind_address: "0.0.0.0"
# photon__data_dir: "/mnt/medias/photon/data"
# photon__java_params: "-Xmx768m"              # 1.8 GiB RAM
# photon__java_params: "-Xmx4g"                # other RAM
# photon__nginx_mode: "subpath"
